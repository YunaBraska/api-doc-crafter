{
  "components" : {
    "schemas" : {
      "Metric" : {
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "timestamp" : {
            "format" : "date-time",
            "type" : "string"
          },
          "type" : {
            "enum" : [ "calories", "heart_rate", "steps", "weight" ],
            "type" : "string"
          },
          "value" : {
            "type" : "number"
          }
        },
        "type" : "object"
      },
      "Trend" : {
        "properties" : {
          "dataPoints" : {
            "items" : {
              "properties" : {
                "timestamp" : {
                  "format" : "date-time",
                  "type" : "string"
                },
                "value" : {
                  "type" : "number"
                }
              },
              "type" : "object"
            },
            "type" : "array"
          },
          "metricId" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "User" : {
        "properties" : {
          "age" : {
            "type" : "integer"
          },
          "email" : {
            "format" : "email",
            "type" : "string"
          },
          "gender" : {
            "enum" : [ "female", "male", "other" ],
            "type" : "string"
          },
          "id" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          }
        },
        "type" : "object"
      }
    }
  },
  "info" : {
    "description" : "API for tracking user health metrics.",
    "title" : "Health Metrics API",
    "version" : "1.0.0"
  },
  "openapi" : "3.0.1",
  "paths" : {
    "/metrics" : {
      "get" : {
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/Metric"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "List of health metrics"
          }
        },
        "summary" : "Retrieve all health metrics"
      },
      "post" : {
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/Metric"
              }
            }
          }
        },
        "responses" : {
          "201" : {
            "description" : "Metric added"
          }
        },
        "summary" : "Add a new metric"
      }
    },
    "/metrics/sync" : {
      "post" : {
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "properties" : {
                  "deviceId" : {
                    "type" : "string"
                  },
                  "metrics" : {
                    "items" : {
                      "$ref" : "#/components/schemas/Metric"
                    },
                    "type" : "array"
                  }
                },
                "type" : "object"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "description" : "Synchronization successful"
          }
        },
        "summary" : "Synchronize metrics with an external device"
      }
    },
    "/metrics/{id}" : {
      "delete" : {
        "parameters" : [ {
          "explode" : false,
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string"
          },
          "style" : "simple"
        } ],
        "responses" : {
          "204" : {
            "description" : "Metric deleted"
          }
        },
        "summary" : "Delete a metric"
      },
      "get" : {
        "parameters" : [ {
          "explode" : false,
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string"
          },
          "style" : "simple"
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Metric"
                }
              }
            },
            "description" : "Metric details"
          }
        },
        "summary" : "Retrieve a specific metric"
      }
    },
    "/metrics/{id}/trend" : {
      "get" : {
        "parameters" : [ {
          "explode" : false,
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string"
          },
          "style" : "simple"
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Trend"
                }
              }
            },
            "description" : "Metric trends"
          }
        },
        "summary" : "Retrieve metric trends over time"
      }
    },
    "/users" : {
      "get" : {
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/User"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "List of users"
          }
        },
        "summary" : "Retrieve all users"
      }
    },
    "/users/{id}" : {
      "get" : {
        "parameters" : [ {
          "explode" : false,
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string"
          },
          "style" : "simple"
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/User"
                }
              }
            },
            "description" : "User details"
          }
        },
        "summary" : "Retrieve a specific user"
      },
      "patch" : {
        "parameters" : [ {
          "explode" : false,
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string"
          },
          "style" : "simple"
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/User"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "description" : "User updated"
          }
        },
        "summary" : "Update user information"
      }
    }
  },
  "servers" : [ {
    "description" : "Original version of the API",
    "url" : "https://api.healthmetrics.example.com/v1"
  } ]
}